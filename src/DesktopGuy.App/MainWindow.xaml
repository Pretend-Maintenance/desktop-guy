<Window x:Class="DesktopGuy.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Desktop Guy"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        ResizeMode="NoResize"
        SizeToContent="Manual"
        WindowStartupLocation="Manual">

    <Window.ContextMenu>
        <ContextMenu>
            <MenuItem Header="Say hi" Click="OnSayHiClicked" />
            <Separator />
            <MenuItem x:Name="CharacterMenuItem" Header="Character" />
            <MenuItem Header="New Character..." Click="OnNewCharacterClicked" />
            <MenuItem x:Name="ScaleMenuItem" Header="Size" />
            <MenuItem Header="Preview Weather">
                <MenuItem Header="Sunny" Click="OnPreviewWeatherClicked" Tag="Sunny" />
                <MenuItem Header="Rainy" Click="OnPreviewWeatherClicked" Tag="Rainy" />
                <MenuItem Header="Hot" Click="OnPreviewWeatherClicked" Tag="Hot" />
                <MenuItem Header="Cold" Click="OnPreviewWeatherClicked" Tag="Cold" />
            </MenuItem>
            <Separator />
            <MenuItem x:Name="StartWithWindowsMenuItem"
                      Header="Start with Windows"
                      IsCheckable="True"
                      Click="OnStartWithWindowsToggled" />
            <Separator />
            <MenuItem Header="Exit" Click="OnExitClicked" />
        </ContextMenu>
    </Window.ContextMenu>

    <Grid x:Name="RootGrid">
        <Image x:Name="CharacterImage"
               Stretch="Fill"
               RenderOptions.BitmapScalingMode="NearestNeighbor"
               RenderTransformOrigin="0.5,0.5"
               MouseLeftButtonDown="OnCharacterMouseDown">
            <Image.RenderTransform>
                <ScaleTransform x:Name="FacingTransform" ScaleX="1" />
            </Image.RenderTransform>
        </Image>

        <!-- Layered on top for an optional cross-fade into the next frame
             (see CharacterDefinition.SmoothTransitions) - never intercepts
             clicks itself, so dragging still works via CharacterImage below. -->
        <Image x:Name="NextCharacterImage"
               Stretch="Fill"
               RenderOptions.BitmapScalingMode="NearestNeighbor"
               RenderTransformOrigin="0.5,0.5"
               IsHitTestVisible="False"
               Opacity="0">
            <Image.RenderTransform>
                <ScaleTransform x:Name="NextFacingTransform" ScaleX="1" />
            </Image.RenderTransform>
        </Image>

        <!-- Anchored to the root Grid rather than CharacterImage - the
             image gets an animated flip (ScaleX -1/1) via RenderTransform
             for facing direction, and WPF's popup-placement math doesn't
             account for a transformed target correctly, which threw the
             bubble off to the side/overlapping instead of sitting above
             his head. The Grid is never transformed, and fills the same
             bounds as the character, so "Top" still lands right above him. -->
        <Popup x:Name="SpeechPopup"
               PlacementTarget="{Binding ElementName=RootGrid}"
               Placement="Top"
               AllowsTransparency="True"
               StaysOpen="True"
               IsOpen="False"
               VerticalOffset="-6">
            <Border Background="#FFFFFFF0"
                    BorderBrush="#FF444444"
                    BorderThickness="1.5"
                    CornerRadius="10"
                    Padding="10,6"
                    MaxWidth="220">
                <TextBlock x:Name="SpeechText"
                           TextWrapping="Wrap"
                           FontFamily="Segoe UI"
                           FontSize="13"
                           Foreground="#FF222222" />
            </Border>
        </Popup>
    </Grid>
</Window>
