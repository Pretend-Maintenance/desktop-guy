<Window x:Class="DesktopGuy.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Desktop Guy"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        ResizeMode="NoResize"
        SizeToContent="Manual"
        WindowStartupLocation="Manual">

    <Window.ContextMenu>
        <ContextMenu>
            <MenuItem Header="Say hi" Click="OnSayHiClicked" />
            <Separator />
            <MenuItem x:Name="StartWithWindowsMenuItem"
                      Header="Start with Windows"
                      IsCheckable="True"
                      Click="OnStartWithWindowsToggled" />
            <Separator />
            <MenuItem Header="Exit" Click="OnExitClicked" />
        </ContextMenu>
    </Window.ContextMenu>

    <Grid>
        <Image x:Name="CharacterImage"
               Stretch="Fill"
               RenderOptions.BitmapScalingMode="NearestNeighbor"
               MouseLeftButtonDown="OnCharacterMouseDown">
            <Image.RenderTransform>
                <ScaleTransform x:Name="FacingTransform" ScaleX="1" />
            </Image.RenderTransform>
            <Image.RenderTransformOrigin>0.5,0.5</Image.RenderTransformOrigin>
        </Image>

        <Popup x:Name="SpeechPopup"
               PlacementTarget="{Binding ElementName=CharacterImage}"
               Placement="Top"
               AllowsTransparency="True"
               StaysOpen="True"
               IsOpen="False"
               VerticalOffset="-6">
            <Border Background="#FFFFFFF0"
                    BorderBrush="#FF444444"
                    BorderThickness="1.5"
                    CornerRadius="10"
                    Padding="10,6"
                    MaxWidth="220">
                <TextBlock x:Name="SpeechText"
                           TextWrapping="Wrap"
                           FontFamily="Segoe UI"
                           FontSize="13"
                           Foreground="#FF222222" />
            </Border>
        </Popup>
    </Grid>
</Window>
