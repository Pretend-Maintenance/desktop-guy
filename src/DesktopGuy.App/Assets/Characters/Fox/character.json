{
  "id": "fox",
  "displayName": "Fox",
  "spriteSheet": "spritesheet.png",
  "frameSize": { "width": 84, "height": 84 },
  "scale": 1.75,
  "smoothTransitions": false,
  "animations": {
    "idle": { "row": 0, "frameCount": 6, "fps": 2, "loop": true },
    "walk": { "row": 1, "frameCount": 6, "fps": 6, "loop": true },
    "sleep": { "row": 2, "frameCount": 6, "fps": 1.5, "loop": true },
    "drag": { "row": 3, "frameCount": 6, "fps": 4, "loop": true },
    "wake": { "row": 4, "frameCount": 2, "fps": 2, "loop": false },
    "dance": { "row": 5, "frameCount": 6, "fps": 5, "loop": true },
    "watch": { "row": 6, "frameCount": 6, "fps": 2, "loop": true },
    "answerCall": { "row": 7, "frameCount": 6, "fps": 4, "loop": false },
    "openMail": { "row": 8, "frameCount": 6, "fps": 4, "loop": false },
    "hacking": { "row": 9, "frameCount": 6, "fps": 3, "loop": true },
    "pickUp": { "row": 10, "frameCount": 2, "fps": 8, "loop": false },
    "hot": { "row": 11, "frameCount": 6, "fps": 3, "loop": true },
    "sunny": { "row": 12, "frameCount": 6, "fps": 2, "loop": true },
    "rainy": { "row": 13, "frameCount": 6, "fps": 3, "loop": true },
    "cold": { "row": 14, "frameCount": 6, "fps": 3, "loop": true }
  },
  "behavior": {
    "idleTimeoutSeconds": 90,
    "walkSpeedPxPerSec": 45,
    "walkIntervalMinSeconds": 10,
    "walkIntervalMaxSeconds": 30,
    "walkDurationMinSeconds": 2,
    "walkDurationMaxSeconds": 5,
    "speechIntervalMinSeconds": 40,
    "speechIntervalMaxSeconds": 120,
    "speechDurationSeconds": 4.5,
    "coldThresholdCelsius": 5,
    "hotThresholdCelsius": 25
  },
  "phrases": [
    "Just foxing around!",
    "Don't forget to stretch a little~",
    "*happy tail wag*",
    "You're doing great today.",
    "Yip!",
    "Comfy over here.",
    "Take a sip of water, maybe?",
    "I like it when you're around.",
    "Foxes nap 12 hours a day, you know.",
    "*ears perk up*",
    "Have you blinked recently? Do that.",
    "Sneaky sneaky~",
    "Keep going, you've got this.",
    "*tail curls up*",
    "I could watch the screen with you all day.",
    "Save your work, just in case!",
    "Nothing wrong with a little break.",
    "You smell like coffee. I approve.",
    "*yawns*",
    "Onwards!",
    "This spot right here is prime real estate.",
    "Pspspsps... oh wait, wrong animal.",
    "Vulpine and proud.",
    "Tell me a secret. I won't tell anyone. Probably."
  ]
}
