    "sleep": { "row": 2, "frameCount": 6, "fps": 1.5, "loop": true },
    "drag": { "row": 3, "frameCount": 6, "fps": 4, "loop": true },
    "wake": { "row": 4, "frameCount": 2, "fps": 2, "loop": false },
    "dance": { "row": 5, "frameCount": 6, "fps": 5, "loop": true },
    "watch": { "row": 6, "frameCount": 6, "fps": 2, "loop": true },
    "answerCall": { "row": 7, "frameCount": 6, "fps": 4, "loop": false },
    "openMail": { "row": 8, "frameCount": 6, "fps": 4, "loop": false },
    "hacking": { "row": 9, "frameCount": 6, "fps": 3, "loop": true },
    "pickUp": { "row": 10, "frameCount": 2, "fps": 8, "loop": false },
    "hot": { "row": 11, "frameCount": 6, "fps": 3, "loop": true },
    "sunny": { "row": 12, "frameCount": 6, "fps": 2, "loop": true },
