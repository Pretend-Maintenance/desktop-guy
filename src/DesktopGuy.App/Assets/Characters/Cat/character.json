  "morningPhrases": [
    "Morning! Did you sleep okay?",
    "Fresh day, fresh fluff.",
    "Coffee first, then world domination.",
    "Rise and shine!"
  ],
  "eveningPhrases": [
    "Winding down for the day?",
    "Evenings are for comfy blankets.",
    "You did a lot today, you know.",
    "Almost dinner time~"
  ],
  "lateNightPhrases": [
    "It's pretty late... just saying.",
    "Cats are nocturnal, but are you?",
    "One more thing and then bed, promise?",
    "*sleepy blink* Still up, huh?"
