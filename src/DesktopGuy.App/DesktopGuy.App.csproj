<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <!-- The windows10.0.19041.0 suffix (rather than plain net8.0-windows) is
         what gives us direct access to the WinRT "Windows.*" APIs used for
         context awareness (now-playing media sessions, notification
         listening) without any extra NuGet packages. TargetPlatformMinVersion
         is kept lower so the app still runs on older Windows 10 - those APIs
         are guarded with try/catch and degrade gracefully if unavailable. -->
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <UseWPF>true</UseWPF>
    <!-- Only for System.Windows.Forms.NotifyIcon - WPF has no tray icon of
         its own, and this is part of the Windows Desktop shared framework
         already, not an extra NuGet dependency. -->
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>DesktopGuy.App</RootNamespace>
    <AssemblyName>DesktopGuy</AssemblyName>
    <StartupObject>DesktopGuy.App.App</StartupObject>
  </PropertyGroup>

  <ItemGroup>
    <!-- Enabling UseWindowsForms alongside UseWPF makes the SDK add a
         global implicit "using System.Windows.Forms;" to every file,
         which collides with System.Windows' own Application/MessageBox/
         Clipboard/... (exactly what broke the build: App.xaml.cs's plain
         "Application" became ambiguous). WinForms is only here for
         NotifyIcon (see TrayIconController.cs, which already references
         System.Windows.Forms explicitly via a `Forms` alias) - removing
         this one global using keeps every other file WPF-only by default. -->
    <Using Remove="System.Windows.Forms" />
  </ItemGroup>

  <ItemGroup>
    <!-- Character templates: each subfolder under Assets/Characters is a
         self-contained companion (character.json + sprite sheet) copied
         next to the built exe so new characters can be added without
         touching any code. -->
    <None Update="Assets\Characters\**\*.*">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

</Project>
