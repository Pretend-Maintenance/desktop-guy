<Window x:Class="DesktopGuy.App.NewCharacterWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="New Character"
        Width="420"
        SizeToContent="Height"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        ShowInTaskbar="True"
        Topmost="True">

    <StackPanel Margin="16">
        <TextBlock Text="Import a new character from a sprite sheet"
                   FontWeight="Bold"
                   FontSize="14"
                   Margin="0,0,0,4" />
        <TextBlock TextWrapping="Wrap"
                   Foreground="#FF555555"
                   FontSize="12"
                   Margin="0,0,0,12"
                   Text="Use a green-background grid PNG, like the ones the AI-art prompt template in the README produces. This covers the common case only - a messier image (off-hue background, hand-drawn grid lines) may need the manual cleanup process described there instead." />

        <TextBlock Text="Character name" Margin="0,0,0,2" />
        <TextBox x:Name="NameTextBox" Margin="0,0,0,10" />

        <TextBlock Text="Sprite sheet PNG" Margin="0,0,0,2" />
        <DockPanel Margin="0,0,0,10">
            <Button Content="Browse..." DockPanel.Dock="Right" Margin="6,0,0,0" Click="OnBrowseClicked" />
            <TextBox x:Name="FilePathTextBox" IsReadOnly="True" />
        </DockPanel>

        <Grid Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0">
                <TextBlock Text="Columns (frames per row)" Margin="0,0,0,2" />
                <TextBox x:Name="ColumnsTextBox" Text="6" />
            </StackPanel>

            <StackPanel Grid.Column="2">
                <TextBlock Text="Rows" Margin="0,0,0,2" />
                <TextBox x:Name="RowsTextBox" Text="19" />
            </StackPanel>
        </Grid>

        <TextBlock x:Name="ErrorText"
                   Foreground="#FFB00020"
                   TextWrapping="Wrap"
                   Margin="0,0,0,10"
                   Visibility="Collapsed" />

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Cancel" Width="80" Margin="0,0,8,0" Click="OnCancelClicked" IsCancel="True" />
            <Button x:Name="ImportButton" Content="Import" Width="80" Click="OnImportClicked" IsDefault="True" />
        </StackPanel>
    </StackPanel>
</Window>
